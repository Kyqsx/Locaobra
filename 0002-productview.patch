+                      color: Colors.black87,
+                    ),
+                  ),
+                ),
+              ],
+            ),
+          ],
+        ],
+      ),
+    );
+  }
+
+  // --- Tipo de locação + quantidade ------------------------------------------
+
+  Widget _buildOpcoes(Equipamento equipamento) {
