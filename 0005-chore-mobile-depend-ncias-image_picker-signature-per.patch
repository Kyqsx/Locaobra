---
 locaobra_mobile/android/app/src/main/AndroidManifest.xml | 3 +++
 locaobra_mobile/pubspec.yaml                             | 4 ++++
 2 files changed, 7 insertions(+)

diff --git a/locaobra_mobile/android/app/src/main/AndroidManifest.xml b/locaobra_mobile/android/app/src/main/AndroidManifest.xml
index cb2a873..a6893f8 100644
--- a/locaobra_mobile/android/app/src/main/AndroidManifest.xml
+++ b/locaobra_mobile/android/app/src/main/AndroidManifest.xml
@@ -1,5 +1,8 @@
 <manifest xmlns:android="http://schemas.android.com/apk/res/android">
     <uses-permission android:name="android.permission.INTERNET"/>
+    <!-- Dashboard do entregador: foto da entrega tirada no local (image_picker). -->
+    <uses-permission android:name="android.permission.CAMERA"/>
+    <uses-feature android:name="android.hardware.camera" android:required="false"/>
 
     <application
         android:label="locaobra_mobile"
diff --git a/locaobra_mobile/pubspec.yaml b/locaobra_mobile/pubspec.yaml
index 819732d..939c066 100644
--- a/locaobra_mobile/pubspec.yaml
+++ b/locaobra_mobile/pubspec.yaml
@@ -17,6 +17,10 @@ dependencies:
   flutter_secure_storage: ^9.2.2
   shared_preferences: ^2.3.2
 
+  # Usados pelo dashboard do entregador (confirmação de entrega no local):
+  image_picker: ^1.1.2 # tirar a foto da entrega na hora
+  signature: ^5.5.0 # quadro de assinatura desenhada de quem recebeu
+
 dev_dependencies:
   flutter_test:
     sdk: flutter
