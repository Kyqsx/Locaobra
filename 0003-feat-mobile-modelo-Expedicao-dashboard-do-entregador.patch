From: Claude <claude@anthropic.com>
Date: Thu, 24 Sep 2026 19:08:32 +0000
Subject: [PATCH 3/9] feat(mobile): modelo Expedicao (dashboard do entregador)

---
 .../lib/entregador/models/expedicao.dart      | 217 ++++++++++++++++++
 1 file changed, 217 insertions(+)
 create mode 100644 locaobra_mobile/lib/entregador/models/expedicao.dart

diff --git a/locaobra_mobile/lib/entregador/models/expedicao.dart b/locaobra_mobile/lib/entregador/models/expedicao.dart
new file mode 100644
index 0000000..d999723
--- /dev/null
+++ b/locaobra_mobile/lib/entregador/models/expedicao.dart
@@ -0,0 +1,217 @@
+import 'package:locaobra_mobile/services/api_client.dart';
+
+/// Espelha com.locaobra.enums.StatusExpedicao (locaobra_api).
+enum StatusExpedicao { agendado, emTransito, entregue, concluido, cancelado }
+
+StatusExpedicao statusExpedicaoFromJson(String? valor) {
+  switch (valor) {
+    case 'EM_TRANSITO':
+      return StatusExpedicao.emTransito;
+    case 'ENTREGUE':
+      return StatusExpedicao.entregue;
+    case 'CONCLUIDO':
+      return StatusExpedicao.concluido;
+    case 'CANCELADO':
+      return StatusExpedicao.cancelado;
+    case 'AGENDADO':
+    default:
+      return StatusExpedicao.agendado;
+  }
+}
+
+String statusExpedicaoParaApi(StatusExpedicao status) {
+  switch (status) {
+    case StatusExpedicao.agendado:
+      return 'AGENDADO';
+    case StatusExpedicao.emTransito:
+      return 'EM_TRANSITO';
+    case StatusExpedicao.entregue:
+      return 'ENTREGUE';
+    case StatusExpedicao.concluido:
+      return 'CONCLUIDO';
+    case StatusExpedicao.cancelado:
+      return 'CANCELADO';
+  }
+}
+
+/// Rótulo em PT-BR — mesmo texto do STATUS_EXPEDICAO_LABEL do
+/// locaobra_web/src/pages/Admin/expedicao.jsx.
+String statusExpedicaoLabel(StatusExpedicao status) {
+  switch (status) {
+    case StatusExpedicao.agendado:
+      return 'Agendado';
+    case StatusExpedicao.emTransito:
+      return 'Em trânsito';
+    case StatusExpedicao.entregue:
+      return 'Entregue';
+    case StatusExpedicao.concluido:
+      return 'Concluído';
+    case StatusExpedicao.cancelado:
+      return 'Cancelado';
+  }
+}
+
+/// Espelha com.locaobra.enums.TipoExpedicao.
+enum TipoExpedicao { entrega, coleta }
+
+TipoExpedicao tipoExpedicaoFromJson(String? valor) =>
+    valor == 'COLETA' ? TipoExpedicao.coleta : TipoExpedicao.entrega;
+
+String tipoExpedicaoLabel(TipoExpedicao tipo) =>
+    tipo == TipoExpedicao.coleta ? 'Coleta' : 'Entrega';
+
+class EnderecoExpedicao {
+  final String? cep;
+  final String? rua;
+  final String? numero;
+  final String? complemento;
+  final String? bairro;
+  final String? cidade;
+  final String? estado;
+  final String? formatado;
+
+  const EnderecoExpedicao({
+    this.cep,
+    this.rua,
+    this.numero,
+    this.complemento,
+    this.bairro,
+    this.cidade,
+    this.estado,
+    this.formatado,
+  });
+
+  factory EnderecoExpedicao.fromJson(Map<String, dynamic>? json) {
+    if (json == null) return const EnderecoExpedicao();
+    return EnderecoExpedicao(
+      cep: json['cep']?.toString(),
+      rua: json['rua']?.toString(),
+      numero: json['numero']?.toString(),
+      complemento: json['complemento']?.toString(),
+      bairro: json['bairro']?.toString(),
+      cidade: json['cidade']?.toString(),
+      estado: json['estado']?.toString(),
+      formatado: json['formatado']?.toString(),
+    );
+  }
+}
+
+class ItemExpedicao {
+  final int id;
+  final String? codigoPatrimonio;
+  final String? equipamentoNome;
+  final int quantidade;
+  final String? observacaoItem;
+
+  const ItemExpedicao({
+    required this.id,
+    this.codigoPatrimonio,
+    this.equipamentoNome,
+    required this.quantidade,
+    this.observacaoItem,
+  });
+
+  factory ItemExpedicao.fromJson(Map<String, dynamic> json) {
+    return ItemExpedicao(
+      id: (json['id'] as num?)?.toInt() ?? 0,
+      codigoPatrimonio: json['codigoPatrimonio']?.toString(),
+      equipamentoNome: json['equipamentoNome']?.toString(),
+      quantidade: (json['quantidade'] as num?)?.toInt() ?? 1,
+      observacaoItem: json['observacaoItem']?.toString(),
+    );
+  }
+
+  /// Mesmo fallback do web (rotuloItem): usa o patrimônio, senão "#id".
+  String get rotulo => (codigoPatrimonio != null && codigoPatrimonio!.isNotEmpty)
+      ? codigoPatrimonio!
+      : '#$id';
+}
+
+/// Espelha com.locaobra.dto.response.ExpedicaoResponse — só os campos que o
+/// app do entregador usa (lista + detalhe + confirmação de entrega).
+class Expedicao {
+  final int id;
+  final String codigo;
+  final TipoExpedicao tipo;
+  final StatusExpedicao status;
+  final String? clienteNome;
+  final String? placaVeiculo;
+  final String? dataProgramada; // yyyy-MM-dd, como vem da API
+  final String? horarioProgramado;
+  final EnderecoExpedicao enderecoEntrega;
+  final String? observacoes;
+  final List<String> nomesAutorizados;
+  final List<ItemExpedicao> itens;
+  final String? entregaConfirmadaEm;
+  final String? fotoEntrega;
+  final String? documentoRecebedor;
+  final String? assinaturaEntrega;
+  final String? motivoCancelamento;
+
+  const Expedicao({
+    required this.id,
+    required this.codigo,
+    required this.tipo,
+    required this.status,
+    this.clienteNome,
+    this.placaVeiculo,
+    this.dataProgramada,
+    this.horarioProgramado,
+    this.enderecoEntrega = const EnderecoExpedicao(),
+    this.observacoes,
+    this.nomesAutorizados = const [],
+    this.itens = const [],
+    this.entregaConfirmadaEm,
+    this.fotoEntrega,
+    this.documentoRecebedor,
+    this.assinaturaEntrega,
+    this.motivoCancelamento,
+  });
+
+  factory Expedicao.fromJson(Map<String, dynamic> json) {
+    final itensJson = json['itens'] as List<dynamic>? ?? [];
+    final nomesJson = json['nomesAutorizados'] as List<dynamic>? ?? [];
+    return Expedicao(
+      id: (json['id'] as num?)?.toInt() ?? 0,
+      codigo: json['codigo']?.toString() ?? '',
+      tipo: tipoExpedicaoFromJson(json['tipo']?.toString()),
+      status: statusExpedicaoFromJson(json['status']?.toString()),
+      clienteNome: json['clienteNome']?.toString(),
+      placaVeiculo: json['placaVeiculo']?.toString(),
+      dataProgramada: json['dataProgramada']?.toString(),
+      horarioProgramado: json['horarioProgramado']?.toString(),
+      enderecoEntrega:
+          EnderecoExpedicao.fromJson(json['enderecoEntrega'] as Map<String, dynamic>?),
+      observacoes: json['observacoes']?.toString(),
+      nomesAutorizados: nomesJson.map((n) => n.toString()).toList(),
+      itens: itensJson
+          .map((i) => ItemExpedicao.fromJson(i as Map<String, dynamic>))
+          .toList(),
+      entregaConfirmadaEm: json['entregaConfirmadaEm']?.toString(),
+      fotoEntrega: json['fotoEntrega']?.toString(),
+      documentoRecebedor: json['documentoRecebedor']?.toString(),
+      assinaturaEntrega: json['assinaturaEntrega']?.toString(),
+      motivoCancelamento: json['motivoCancelamento']?.toString(),
+    );
+  }
+
+  bool get ehColeta => tipo == TipoExpedicao.coleta;
+
+  /// Mesma regra do web (isFinalizada em expedicao.jsx): ENTREGA termina em
+  /// ENTREGUE (o equipamento fica com o cliente); COLETA só termina em
+  /// CONCLUIDO/CANCELADO.
+  bool get finalizada =>
+      status == StatusExpedicao.concluido ||
+      status == StatusExpedicao.cancelado ||
+      (!ehColeta && status == StatusExpedicao.entregue);
+
+  /// Só pode confirmar a entrega/coleta no local depois que o conferente já
+  /// fez o check-out (status vira EM_TRANSITO) — mesma condição do web:
+  /// `podeConfirmarEntrega = status === 'EM_TRANSITO' && !entregaConfirmada`.
+  /// (entregaConfirmadaEm nulo == ainda não confirmada.)
+  bool get podeConfirmar =>
+      status == StatusExpedicao.emTransito && entregaConfirmadaEm == null;
+
+  String get fotoEntregaUrl => ApiClient.resolveUrl(fotoEntrega);
+  String get assinaturaEntregaUrl => ApiClient.resolveUrl(assinaturaEntrega);
+}
