From 4d90a56652490e48d26ff58cbc3b03477f9c0211 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Thu, 24 Sep 2026 19:19:35 +0000
Subject: [PATCH] fix(mobile): lint - withOpacity -> withValues(alpha:) e
 remover underscores duplos

---
 .../lib/entregador/screens/entregador_home_page.dart          | 4 ++--
 .../lib/entregador/widgets/status_expedicao_badge.dart        | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/locaobra_mobile/lib/entregador/screens/entregador_home_page.dart b/locaobra_mobile/lib/entregador/screens/entregador_home_page.dart
index 7ee443a..31e32bd 100644
--- a/locaobra_mobile/lib/entregador/screens/entregador_home_page.dart
+++ b/locaobra_mobile/lib/entregador/screens/entregador_home_page.dart
@@ -111,7 +111,7 @@ class _EntregadorHomePageState extends State<EntregadorHomePage> {
                     physics: const AlwaysScrollableScrollPhysics(),
                     padding: const EdgeInsets.all(16),
                     itemCount: filtradas.length,
-                    separatorBuilder: (_, __) => const SizedBox(height: 10),
+                    separatorBuilder: (context, index) => const SizedBox(height: 10),
                     itemBuilder: (context, index) =>
                         _ExpedicaoCard(expedicao: filtradas[index], onTap: () => _abrirDetalhe(filtradas[index])),
                   );
@@ -156,7 +156,7 @@ class _EntregadorHomePageState extends State<EntregadorHomePage> {
                 label: Text(opcao.key),
                 selected: selecionado,
                 onSelected: (_) => setState(() => _filtro = opcao.value),
-                selectedColor: _corPrimaria.withOpacity(0.18),
+                selectedColor: _corPrimaria.withValues(alpha: 0.18),
                 labelStyle: TextStyle(
                   color: selecionado ? _corPrimaria : Colors.black87,
                   fontWeight: selecionado ? FontWeight.w600 : FontWeight.normal,
diff --git a/locaobra_mobile/lib/entregador/widgets/status_expedicao_badge.dart b/locaobra_mobile/lib/entregador/widgets/status_expedicao_badge.dart
index 9d6b645..00ba2c2 100644
--- a/locaobra_mobile/lib/entregador/widgets/status_expedicao_badge.dart
+++ b/locaobra_mobile/lib/entregador/widgets/status_expedicao_badge.dart
@@ -30,9 +30,9 @@ class StatusExpedicaoBadge extends StatelessWidget {
     return Container(
       padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
       decoration: BoxDecoration(
-        color: cor.withOpacity(0.12),
+        color: cor.withValues(alpha: 0.12),
         borderRadius: BorderRadius.circular(20),
-        border: Border.all(color: cor.withOpacity(0.4)),
+        border: Border.all(color: cor.withValues(alpha: 0.4)),
       ),
       child: Text(
         statusExpedicaoLabel(status),
-- 
2.43.0

